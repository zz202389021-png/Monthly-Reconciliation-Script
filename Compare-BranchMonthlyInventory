#requires -Version 5.1
<#!
.SYNOPSIS
    Compare a system inventory workbook with a branch monthly inventory workbook.
    The current released comparison target is 运营&高值盘点单.
#>

param(
    [string]$SystemFile,
    [string]$BranchFile,
    [string]$OutputFile,
    [ValidateSet('运营&高值盘点单', '机房盘点单', '行政盘点单')]
    [string]$Target,
    [switch]$NoDialog
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$TargetAliases = @{
    '运营&高值盘点单' = @('运营&高值盘点单', '运营资产', '运营+高值', '运营高值', '高值易耗')
    '机房盘点单' = @('机房盘点单', '机房网络', '机房设备', '机房类')
    '行政盘点单' = @('行政盘点单', '行政资产', '行政类')
}

$ColumnAliases = @{
    '营运区' = @('营运区', '运营区')
    '分拨' = @('分拨', '分拨中心')
    '设备名称' = @('设备名称', '物资名称', '名称')
    '应盘数量' = @('应盘数量', '账面数量', '系统数量', '应盘')
    '实盘数量' = @('实盘数量', '盘点数量', '实际数量', '实盘')
}

